@api = http://localhost:3000/api
### search books
GET {{api}}/books HTTP/1.1

###search title
GET {{api}}/books?q=1

###add book
POST {{api}}/books?q=1 content-type: application/json

{
    "title": "NewBook",
    "writer": "Jade"
}

###get one
GET {{api}}/books/1

### edit one
PATCH {{api}}/books/1
content-type: application/json

{
    "title": "New Title"
}

### delete one
DELETE {{api}}/books/2


